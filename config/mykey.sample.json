{
  "note": "このファイルを mykey.json にコピーして、実キーを入れてください。mykey.json はGit管理しないでください。",

  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "RefreshToken": "YOUR_YOUTUBE_REFRESH_TOKEN",
    "TokenFile": ".\\config\\youtube_tokens.json"
  },

  "Dify": {
    "ApiKey": "YOUR_DIFY_API_KEY",
    "ApiUrl": "https://api.dify.ai/v1/chat-messages",
    "User": "ai-stream-user"
  },

  "YouTube": {
    "PollSeconds": 5,
    "MaxReplyLength": 180
  },

  "Cartesia": {
    "Enabled": false,
    "ApiKey": "YOUR_CARTESIA_API_KEY",
    "VoiceId": "YOUR_VOICE_ID",
    "OutputDir": ".\\audio"
  }
}
